---
// lucide-static의 SVG를 파일에서 읽어 그대로 인라인한다 — 아이콘 폰트(Font
// Awesome)처럼 전체 세트를 CDN에서 받아올 필요 없이, 쓰는 것만 빌드에 포함된다.
// stroke="currentColor"라서 부모 요소의 color로 색이 정해진다.
import { readFileSync } from "node:fs";
import { join } from "node:path";

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const raw = readFileSync(
  join(process.cwd(), "node_modules/lucide-static/icons", `${name}.svg`),
  "utf-8",
);

const svg = raw
  .replace(/<!--[\s\S]*?-->\s*/, "")
  .replace(/\bwidth="24"/, `width="${size}"`)
  .replace(/\bheight="24"/, `height="${size}"`)
  .replace(/class="[^"]*"/, `class="icon${className ? ` ${className}` : ""}"`);
---

<Fragment set:html={svg} />
