---
// _layouts/benchmark_run.html을 옮긴 것. _benchmarks 컬렉션(18개 날짜 슬러그)에서 쓴다.
import benchmarks from "../../data/benchmarks.json";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const bm = benchmarks;
const run = bm.runs.find((r) => r.slug === slug)!;
---

<div class="container">
  <div class="breadcrumbs">
    <a href="/benchmarks/">&larr; All benchmarks</a>
  </div>

  <div class="page-header">
    <h1>Benchmark run</h1>
    <p class="section-subtitle">{run.date}</p>
  </div>

  <section class="py-lg">
    <div class="bench-meta">
      <span><i class="fas fa-flask"></i> {bm.dataset.name} &middot; {bm.dataset.instrument}</span>
      <span><i class="fas fa-server"></i> AWS {run.instance}</span>
      {run.runtime_hours && <span><i class="fas fa-clock"></i> {run.runtime_hours} h</span>}
    </div>
  </section>

  <section class="py-lg">
    <div class="bench-stats">
      <div class="bench-stat">
        <span class="bench-stat-value">{run.total_precursors_display}</span>
        <span class="bench-stat-label">Precursors</span>
      </div>
      <div class="bench-stat">
        <span class="bench-stat-value">{run.total_proteins_display}</span>
        <span class="bench-stat-label">Protein groups</span>
      </div>
      <div class="bench-stat">
        <span class="bench-stat-value">{run.files_in_experiment}</span>
        <span class="bench-stat-label">Raw files analysed</span>
      </div>
    </div>
  </section>

  {run.has_accuracy ? (
    <section class="py-lg">
      <div class="section-header">
        <h2>Quantification Accuracy</h2>
        <p class="section-subtitle">
          LFQBench mixes human, yeast and <em>E.&nbsp;coli</em> proteins into two samples at
          fixed, known ratios. A perfect result lands exactly on the target line.
        </p>
      </div>

      <div class="bench-scale">
        {run.accuracy!.map((item) => {
          const targetPos = (item.target_log2_ratio + 2.5) * 25;
          const valuePos = (item.median_log2_ratio + 2.5) * 25;
          const bandHalf = item.mad_from_target * 25;
          const bandLeft = valuePos - bandHalf;
          const bandWidth = bandHalf * 2;
          return (
            <div class="bench-species">
              <div class="bench-species-head">
                <h3>{item.label}</h3>
                <span class="bench-count">{item.count_display} precursors</span>
              </div>

              <div class="bench-track">
                <div class="bench-band" style={`left: ${bandLeft}%; width: ${bandWidth}%;`} />
                <div class="bench-target" style={`left: ${targetPos}%;`}>
                  <span class="bench-target-label">target {item.target_log2_ratio}</span>
                </div>
                <div class="bench-value" style={`left: ${valuePos}%;`}>
                  <span class="bench-value-label">{item.median_log2_ratio}</span>
                </div>
              </div>

              <div class="bench-species-foot">
                <span>deviation from target <strong>{item.deviation}</strong></span>
                <span>spread (MAD) <strong>{item.mad_from_target}</strong></span>
              </div>
            </div>
          );
        })}

        <p class="bench-axis-note">
          Horizontal axis: log<sub>2</sub> ratio between the two samples.
          The shaded band shows the median absolute deviation — how tightly
          individual measurements cluster around the target.
        </p>
      </div>
    </section>
  ) : (
    <section class="py-lg">
      <p class="bench-axis-note">
        Quantification accuracy was not recorded for this run —
        the LFQBench analysis was added to the pipeline later.
        <a href="/benchmarks/">See the run list</a> for runs that include it.
      </p>
    </section>
  )}

  <section class="py-lg">
    <div class="section-header">
      <h2>Per-file Results</h2>
      <p class="section-subtitle">
        Each of the {run.files_in_experiment} raw files, analysed independently.
        Mass and retention-time errors indicate calibration quality.
      </p>
    </div>

    <div class="bench-table-wrap">
      <table class="bench-table">
        <thead>
          <tr>
            <th>File</th>
            <th class="num">Precursors</th>
            <th class="num">Proteins</th>
            <th class="num">MS1 error</th>
            <th class="num">MS2 error</th>
            <th class="num">RT error</th>
            <th class="num">FWHM (RT)</th>
          </tr>
        </thead>
        <tbody>
          {run.files.map((file) => (
            <tr>
              <td><code>{file.short_name}</code></td>
              <td class="num">{file.precursors_display}</td>
              <td class="num">{file.proteins_display}</td>
              <td class="num">{file.ms1_error}</td>
              <td class="num">{file.ms2_error}</td>
              <td class="num">{file.rt_error}</td>
              <td class="num">{file.fwhm_rt}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="py-lg">
    <div class="highlight-section">
      <h2>How this was measured</h2>
      <p>
        {bm.dataset.name} is a community-standard benchmark for label-free quantification.
        Because the mixing ratios are fixed when the samples are prepared, the correct answer
        is known independently of any software — which makes it possible to measure
        accuracy rather than merely report output volume.
      </p>

      <div class="bench-method">
        <div>
          <h4>Dataset</h4>
          <p>
            {bm.dataset.instrument} — {run.files_in_experiment} raw files:
            conditions {bm.dataset.conditions.join(" and ")},
            {bm.dataset.replicates} replicates each.
          </p>
        </div>
        <div>
          <h4>Ground truth</h4>
          <p>
            Expected log<sub>2</sub> ratios — Human 0.0, E. coli -2.0, Yeast 1.0.
          </p>
        </div>
        <div>
          <h4>Environment</h4>
          <p>AWS {run.instance}, single run. Random seed fixed so the analysis is reproducible.</p>
        </div>
        <div>
          <h4>Scope</h4>
          <p>
            Measured on the {bm.filter.branch} branch of the SynapSpec engine.
            Runtime reflects one run on shared infrastructure and will vary with hardware.
          </p>
        </div>
      </div>
    </div>
  </section>

  <nav class="bench-pager">
    {run.prev_slug ? <a href={`/benchmarks/${run.prev_slug}/`}>&larr; {run.prev_slug}</a> : <span />}
    {run.next_slug ? <a href={`/benchmarks/${run.next_slug}/`}>{run.next_slug} &rarr;</a> : <span />}
  </nav>
</div>
