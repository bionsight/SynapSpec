---
// _includes/benchmark/imported.html을 옮긴 것. kind: imported인 3개 항목에서 쓴다.
import imports from "../../data/benchmark_imports.json";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const run = imports.find((r) => r.slug === slug)!;
const hours = Math.trunc(run.runtimeMinutes / 60);
const minutes = run.runtimeMinutes % 60;
---

<div class="container">
  <div class="breadcrumbs">
    <a href="/benchmarks/">&larr; Benchmarks</a>
  </div>

  <div class="page-header">
    <h1>LFQBench <span class="bench-muted">/ Orbitrap Astral</span></h1>
  </div>

  <section class="py-lg bench-border-y" aria-label="Run results">
    <h2>Results</h2>
    <p class="bench-lede">{run.totalPrecursorsDisplay}<span class="bench-lede-unit"> precursor IDs</span></p>
  </section>

  {run.figure && (
    <section class="py-lg bench-border-b" aria-label="Run figures">
      <h2>Analysis figures</h2>
      <a href={`/assets/images/benchmarks/${run.figure}`} target="_blank" rel="noreferrer" class="bench-figure-link">
        <img src={`/assets/images/benchmarks/${run.figure}`} width="4838" height="5121" alt={`Original analysis summary for SynapSpec ${run.commit}: identification counts, completeness, CV distributions and LFQ plots with comparator reports.`} />
      </a>
      <div class="bench-figure-actions">
        <a href={`/assets/images/benchmarks/${run.figure}`} target="_blank" rel="noreferrer">Open full-size figure</a>
        <a href={`/assets/images/benchmarks/${run.figure}`} download>Download figure</a>
      </div>
    </section>
  )}

  <section class="py-lg">
    <h2>Execution &amp; source</h2>
    <dl class="bench-facts">
      <div><dt>Status</dt><dd>{run.status}</dd></div>
      <div><dt>Commit (task label)</dt><dd>{run.commit}</dd></div>
      <div><dt>Started (ClearML display)</dt><dd>{run.started}</dd></div>
      <div><dt>Completed (ClearML display)</dt><dd>{run.completed}</dd></div>
      <div><dt>Task elapsed time</dt><dd>{hours} h {minutes} min</dd></div>
      <div><dt>Resource tag</dt><dd>{run.resource}</dd></div>
      <div><dt>Source Task ID</dt><dd>{run.taskId}</dd></div>
      <div><dt>Artifact label</dt><dd>{run.artifactId}</dd></div>
    </dl>
  </section>

  <section class="py-lg bench-border-t">
    <h2>Inputs &amp; recorded configuration</h2>
    <ul class="bench-file-list">
      {run.files.map((file) => <li>{file}</li>)}
    </ul>
  </section>
</div>
