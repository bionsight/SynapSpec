---
// Reference selection follows the run's ledger; dataset-specific calculation
// methods and original report sources are documented in docs/benchmarks/lfq.
import CvDistributionWidget from "./CvDistributionWidget.astro";
import catalog from "../../data/benchmark_catalog.json";
import ledgers from "../../data/benchmark_ledger.json";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const entry = catalog.recorded_runs[slug as keyof typeof catalog.recorded_runs];
const diagnostics = (entry as { diagnostics?: any }).diagnostics;

const ledger = ledgers.find((l) => l.rows.some((r) => r.sourceSlug === slug));
const toolDiagnostics = (catalog as { tool_diagnostics?: Record<string, any> }).tool_diagnostics;
const extraTools = ["DIA-NN", "Spectronaut"]
  .map((tool) => {
    const ref = ledger?.toolReferences.find((r) => r.tool === tool && r.sourceSlug);
    const data = ref ? toolDiagnostics?.[ref.sourceSlug as string] : undefined;
    return data ? { tool, diagnostics: data } : null;
  })
  .filter((t): t is { tool: string; diagnostics: any } => t !== null);
---

{diagnostics && (
  <div
    class="bench-diagnostics-grid"
    data-diagnostics={JSON.stringify(diagnostics)}
    data-extra-tools={extraTools.length ? JSON.stringify(extraTools) : ""}
  >
    <figure class="bench-diagnostic">
      <div data-chart="completeness" class="bench-plotly-target bench-plotly-fade"></div>
      <figcaption>Data completeness</figcaption>
    </figure>
    <CvDistributionWidget slug={slug} />
  </div>
)}

<script>
  import Plotly from "plotly.js-cartesian-dist-min";
  import { baseLayout, axisStyle, baseConfig, COLORS, TOOL_COLORS } from "../../lib/plotlyTheme";

  const toolColor = (tool: string) => TOOL_COLORS[tool.toLowerCase().replace(/[^a-z]/g, "")] ?? COLORS.textLight;

  document.querySelectorAll<HTMLElement>("[data-diagnostics]").forEach((container) => {
    const diagnostics = JSON.parse(container.dataset.diagnostics!);
    const extraTools: { tool: string; diagnostics: any }[] = container.dataset.extraTools
      ? JSON.parse(container.dataset.extraTools)
      : [];
    const hasExtras = extraTools.length > 0;
    const completenessEl = container.querySelector<HTMLElement>('[data-chart="completeness"]');
    if (!completenessEl) return;

    const completenessTraces = [{ tool: "SynapSpec", diagnostics }, ...extraTools]
      .map(({ tool, diagnostics: d }) => {
        const dc = d.data_completeness;
        return {
          type: "bar",
          name: tool,
          x: dc.bars.map((b: any) => String(b.n)),
          y: dc.bars.map((b: any) => b.count),
          text: dc.bars.map((b: any) => b.count_display),
          textposition: "outside",
          marker: { color: toolColor(tool) },
          hovertemplate: `${tool}<br>Detected in %{x} file(s)<br>%{y:,} precursors<extra></extra>`,
        };
      });
    Plotly.newPlot(
      completenessEl,
      completenessTraces,
      baseLayout({
        xaxis: { ...axisStyle, title: { text: "Detected in N files" }, showgrid: false },
        yaxis: { ...axisStyle, title: { text: "Precursor count" } },
        ...(hasExtras
          ? { barmode: "group", showlegend: true, legend: { orientation: "h", x: 0, y: 1.15 }, margin: { t: 34, r: 20, b: 40, l: 50 } }
          : {}),
      }),
      baseConfig,
    ).then(() => completenessEl.classList.add("is-visible"));

  });
</script>
