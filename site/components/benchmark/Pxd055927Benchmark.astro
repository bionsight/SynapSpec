---
// PXD055927 is a deliberately dedicated comparison. Its export is not the
// LFQBench ledger schema: the external workflows have source-table coverage
// and exploratory specificity mapping. Keep this comparison in a dedicated
// component rather than coercing the data into existing LFQ widgets.
import comparison from "../../data/pxd055927/comparison.json";

type ToolData = (typeof comparison.tools)[number];

const tools = comparison.tools;

if (typeof comparison.synapspec_version !== "string" || !comparison.synapspec_version.trim()) {
  throw new Error("PXD055927 comparison requires the actual SynapSpec analysis version");
}

const expectedTools = ["SynapSpec", "FragPipe + DIA-NN", "Spectronaut"] as const;
if (
  comparison.dataset !== "bion-semi-specific-pxd055927" ||
  comparison.status !== "reference_comparison_not_matched_benchmark" ||
  tools.length !== expectedTools.length ||
  tools.some((tool, index) => tool.tool !== expectedTools[index])
) {
  throw new Error("PXD055927 export has an unexpected dataset, status, or tool order");
}

const numberFormat = new Intl.NumberFormat("en-US");
const formatCount = (value: number) => numberFormat.format(value);
const toolIds: Record<string, string> = {
  SynapSpec: "synapspec",
  "FragPipe + DIA-NN": "diann",
  Spectronaut: "spectronaut",
};
const toolId = (tool: ToolData["tool"]) => {
  const id = toolIds[tool];
  if (!id) throw new Error(`PXD055927 export has an unsupported tool: ${tool}`);
  return id;
};
const identificationChartData = tools.map((tool) => ({
  tool: tool.tool,
  id: toolId(tool.tool),
  peptide_count: tool.peptide_count,
  precursor_count: tool.precursor_count,
}));

const cvChartData = tools.map((tool) => ({
  tool: tool.tool,
  id: toolId(tool.tool),
  cv: tool.cv,
}));

const specificityChartData = tools.map((tool) => ({
  tool: tool.tool,
  id: toolId(tool.tool),
  specific: tool.specificity.specific,
  semi_specific: tool.specificity.semi_specific,
  non_specific_excluded: tool.specificity.non_specific_excluded,
  unmapped_excluded: tool.specificity.unmapped_excluded,
}));

const specificityDenominator = (tool: ToolData) => tool.specificity.specific + tool.specificity.semi_specific;
---

<div
  class="pxd055927-benchmark"
  data-pxd055927
  data-identification={JSON.stringify(identificationChartData)}
  data-cv={JSON.stringify(cvChartData)}
  data-specificity={JSON.stringify(specificityChartData)}
>
  <p class="pxd055927-reference-note">Reference comparison — not a matched benchmark. SynapSpec is parquet-derived; external values are transcribed.</p>

  <section class="pxd055927-section" aria-labelledby="pxd055927-identification-heading">
    <p class="bench-scatter-compare-label" id="pxd055927-identification-heading">Diagnostic plots</p>

    <div class="bench-diagnostics-grid pxd055927-chart-grid">
      <figure class="bench-diagnostic">
        <div
          data-chart="identification"
          class="bench-plotly-target bench-plotly-fade"
          role="img"
          aria-label="Peptide and precursor identification counts for SynapSpec, FragPipe plus DIA-NN, and Spectronaut"
        ></div>
        <figcaption>Unique peptide and precursor identifications</figcaption>
      </figure>
      <figure class="bench-diagnostic">
        <div
          data-chart="cv"
          class="bench-plotly-target bench-plotly-fade"
          role="img"
          aria-label="Dose-matched peptide coefficient of variation box plots for SynapSpec, FragPipe plus DIA-NN, and Spectronaut"
        ></div>
        <figcaption>Peptide CV across dose-matched biological triplicates</figcaption>
      </figure>
    </div>

  </section>

  <section class="pxd055927-section" aria-labelledby="pxd055927-specificity-heading">
    <h2 class="pxd055927-subheading" id="pxd055927-specificity-heading">Precursor cleavage specificity</h2>

    <div class="bench-comparison-row pxd055927-specificity-grid">
      {tools.map((tool) => (
        <figure class="bench-diagnostic pxd055927-specificity-card">
          <h3>{tool.tool}</h3>
          <div
            data-chart={`specificity-${toolId(tool.tool)}`}
            class="bench-plotly-target bench-plotly-fade"
            role="img"
            aria-label={`${tool.tool} precursor specificity: specific versus semi-specific`}
          ></div>
          <figcaption>
            <strong>{formatCount(specificityDenominator(tool))} plotted precursors</strong>
            <span>
              Non-specific excluded: {formatCount(tool.specificity.non_specific_excluded)} · Unmapped excluded:
              {" "}{formatCount(tool.specificity.unmapped_excluded)}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
    <ul class="bench-chart-legend pxd055927-legend" aria-label="Precursor specificity legend">
      <li><span class="bench-chart-legend-swatch pxd055927-legend-specific"></span>Specific</li>
      <li><span class="bench-chart-legend-swatch pxd055927-legend-semi"></span>Semi-specific</li>
    </ul>
  </section>

  <section class="pxd055927-section pxd055927-sources" aria-label="Sources">
    <details class="bench-details">
      <summary>Sources</summary>
      <ul class="pxd055927-source-list">
        <li><strong>SynapSpec</strong><span>{comparison.synapspec_version}</span></li>
        {tools.filter((tool) => tool.tool !== "SynapSpec").map((tool) => (
          <li>
            <strong>{tool.tool}</strong>
            <span class="bench-muted">{tool.entry_method === "parquet_computed" ? "Parquet-derived" : "Manual transcription"}</span>
            <span class="pxd055927-source-links">
              {tool.sources.map((source) => <a href={source.url} target="_blank" rel="noopener">{source.title} ↗</a>)}
            </span>
          </li>
        ))}
      </ul>
    </details>
  </section>
</div>

<script>
  import Plotly from "plotly.js-cartesian-dist-min";
  import { baseLayout, axisStyle, baseConfig, COLORS, TOOL_COLORS, drawWhenVisible } from "../../lib/plotlyTheme";

  type IdentificationDatum = {
    tool: string;
    id: string;
    peptide_count: number;
    precursor_count: number;
  };
  type CvDatum = {
    tool: string;
    id: string;
    cv: {
      n: number;
      peptide_count: number;
      q1: number;
      median: number;
      q3: number;
      lowerfence: number;
      upperfence: number;
    };
  };
  type SpecificityDatum = {
    tool: string;
    id: string;
    specific: number;
    semi_specific: number;
    non_specific_excluded: number;
    unmapped_excluded: number;
  };

  const pieColors = [COLORS.primary, "#e69f00"];
  const colorFor = (id: string) => TOOL_COLORS[id] ?? COLORS.textLight;
  const percent = (value: number, digits = 1) => `${(value * 100).toFixed(digits)}%`;
  const count = (value: number) => value.toLocaleString("en-US");

  const withAlpha = (hex: string, alpha: number) => {
    const number = parseInt(hex.slice(1), 16);
    const red = (number >> 16) & 255;
    const green = (number >> 8) & 255;
    const blue = number & 255;
    return `rgba(${red}, ${green}, ${blue}, ${alpha})`;
  };

  const requiredDataset = (container: HTMLElement, field: string) => {
    const value = container.dataset[field];
    if (!value) throw new Error(`PXD055927 chart data attribute is missing: ${field}`);
    return value;
  };

  document.querySelectorAll<HTMLElement>("[data-pxd055927]").forEach((container) => {
    const identification = JSON.parse(requiredDataset(container, "identification")) as IdentificationDatum[];
    const cv = JSON.parse(requiredDataset(container, "cv")) as CvDatum[];
    const specificity = JSON.parse(requiredDataset(container, "specificity")) as SpecificityDatum[];

    const identificationEl = container.querySelector<HTMLElement>('[data-chart="identification"]');
    if (identificationEl) {
      drawWhenVisible(identificationEl, () => {
        const traces = [
          { key: "peptide_count" as const, label: "Peptides" },
          { key: "precursor_count" as const, label: "Precursors" },
        ].map((metric) => ({
          type: "bar",
          name: metric.label,
          x: identification.map((datum) => datum.tool),
          y: identification.map((datum) => datum[metric.key]),
          text: identification.map((datum) => count(datum[metric.key])),
          textposition: "outside",
          marker: {
            color: identification.map((datum) => colorFor(datum.id)),
            ...(metric.key === "precursor_count" ? { pattern: { shape: "/" } } : {}),
          },
          hovertemplate: `%{x} · ${metric.label}<br>%{text}<extra></extra>`,
        }));

        Plotly.newPlot(
          identificationEl,
          traces,
          baseLayout({
            margin: { t: 48, r: 18, b: 70, l: 58 },
            barmode: "group",
            bargap: 0.2,
            bargroupgap: 0.06,
            showlegend: true,
            legend: { orientation: "h", x: 0.5, xanchor: "center", y: 1.16, yanchor: "top" },
            xaxis: { ...axisStyle, showgrid: false, tickangle: -18 },
            yaxis: { ...axisStyle, title: { text: "Unique identifications" }, rangemode: "tozero" },
          }),
          baseConfig,
        ).then(() => identificationEl.classList.add("is-visible"));
      });
    }

    const cvEl = container.querySelector<HTMLElement>('[data-chart="cv"]');
    if (cvEl) {
      drawWhenVisible(cvEl, () => {
        const traces = cv.map((datum) => ({
          type: "box",
          name: datum.tool,
          x: [datum.tool],
          q1: [datum.cv.q1],
          median: [datum.cv.median],
          q3: [datum.cv.q3],
          lowerfence: [datum.cv.lowerfence],
          upperfence: [datum.cv.upperfence],
          text: [
            `median ${percent(datum.cv.median)} · Q1 ${percent(datum.cv.q1)} · Q3 ${percent(datum.cv.q3)} · ` +
              `n = ${count(datum.cv.n)} peptide × dose`,
          ],
          marker: { color: colorFor(datum.id) },
          fillcolor: withAlpha(colorFor(datum.id), 0.22),
          line: { color: colorFor(datum.id) },
          boxpoints: false,
          hovertemplate: `${datum.tool}<br>%{text}<extra></extra>`,
        }));

        Plotly.newPlot(
          cvEl,
          traces,
          baseLayout({
            margin: { t: 18, r: 18, b: 82, l: 58 },
            xaxis: { ...axisStyle, showgrid: false, tickangle: -18 },
            yaxis: { ...axisStyle, title: { text: "Peptide quantity CV" }, tickformat: ".0%", rangemode: "tozero" },
          }),
          baseConfig,
        ).then(() => cvEl.classList.add("is-visible"));
      });
    }

    specificity.forEach((datum) => {
      const el = container.querySelector<HTMLElement>(`[data-chart="specificity-${datum.id}"]`);
      if (!el) return;

      const denominator = datum.specific + datum.semi_specific;
      drawWhenVisible(el, () => {
        Plotly.newPlot(
          el,
          [
            {
              type: "pie",
              labels: ["Specific", "Semi-specific"],
              values: [datum.specific, datum.semi_specific],
              textinfo: "percent",
              textposition: "inside",
              insidetextorientation: "horizontal",
              hole: 0.52,
              sort: false,
              direction: "clockwise",
              marker: { colors: pieColors, line: { color: COLORS.background, width: 2 } },
              textfont: { color: COLORS.background, size: 12 },
              hovertemplate: `${datum.tool}<br>%{label}: %{value:,} (%{percent})<extra></extra>`,
            },
          ],
          baseLayout({
            margin: { t: 8, r: 8, b: 8, l: 8 },
            annotations: [
              {
                x: 0.5,
                y: 0.5,
                text: `<b>${count(denominator)}</b><br><span style="font-size:10px;color:${COLORS.textLight}">plotted</span>`,
                showarrow: false,
                align: "center",
              },
            ],
          }),
          baseConfig,
        ).then(() => el.classList.add("is-visible"));
      });
    });
  });
</script>
