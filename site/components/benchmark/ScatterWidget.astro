---
// Native reinterpretation of the third ClearML diagnostic image
// (lfq_scatter_precursor). One point per precursor with both A and B
// quantities positive: x = log2(mean quantity in B), y = log2(A/B).
// Values match instrumentation/parsers/lfq.py's get_lfq_quantification exactly
// (mean quantity per precursor per condition, log2(B) and log2(A/B)).
// Marginal histograms from the original image are left out — the ratio and
// quartile widgets above already cover per-species distribution shape.
//
// When this run's dataset has DIA-NN/Spectronaut references (same lookup
// DiagnosticsWidget uses), they render as extra panels alongside SynapSpec —
// two or three ~100k-300k-point clouds stacked on one plot would just be
// noise on noise.
//
// This used to be a client-side Plotly.js widget that fetched each tool's
// multi-megabyte point-cloud JSON and drew it with scattergl — that fetch +
// WebGL draw is what made the run-detail page freeze on first visit. It's
// now a single pre-rendered PNG (scripts/render_scatter_images.py, run at
// data-prep time from the same point-cloud JSON this widget used to fetch
// itself) with a shared axis range baked in across every panel, so there's
// no client-side data cost at all — just an <img>.
import catalog from "../../data/benchmark_catalog.json";
import ledgers from "../../data/benchmark_ledger.json";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const entry = catalog.recorded_runs[slug as keyof typeof catalog.recorded_runs];
const ratios = (entry as { ratio_measurements?: any[] }).ratio_measurements;
const imageUrl = `/data/benchmarks/scatter-${slug}.png`;

const ledger = ledgers.find((l) => l.rows.some((r) => r.sourceSlug === slug));
const extraTools = ["DIA-NN", "Spectronaut"].filter((tool) =>
  ledger?.toolReferences.some((r) => r.tool === tool && r.sourceSlug),
);
const imageAlt = `LFQ precursor scatter — ${["SynapSpec", ...extraTools].join(" vs. ")}`;
---

{ratios && (
  <div class="bench-scatter-compare">
    <p class="bench-scatter-compare-label">LFQ precursor scatter</p>
    <figure class="bench-diagnostic bench-diagnostic-last">
      <img src={imageUrl} alt={imageAlt} loading="lazy" class="bench-scatter-image" />
    </figure>
  </div>
)}
