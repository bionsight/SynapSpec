---
// Accuracy by intensity quartile — a small multiples line chart, one per species.
// Q1 = lowest-intensity quarter of paired precursors, Q4 = highest.
// Values (median/lower/upper per quartile, log2-scaled) come from
// _data/benchmark_catalog.json's quartile_measurements, built in
// build_quartile_data.py from ClearML's lfq_quartile_statistics table.
//
// DIA-NN/Spectronaut references (same ledger lookup as the other widgets)
// overlay as extra lines per species, computed the same way —
// get_lfq_quartile_statistics from instrumentation/parsers/lfq.py, on each
// tool's own quantification arrays.
import catalog from "../../data/benchmark_catalog.json";
import ledgers from "../../data/benchmark_ledger.json";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const entry = catalog.recorded_runs[slug as keyof typeof catalog.recorded_runs];
const quartiles = (entry as { quartile_measurements?: any[] }).quartile_measurements;

const ledger = ledgers.find((l) => l.rows.some((r) => r.sourceSlug === slug));
const extraTools = ["DIA-NN", "Spectronaut"]
  .map((tool) => {
    const ref = ledger?.toolReferences.find((r) => r.tool === tool && r.sourceSlug);
    const rows = ref ? (catalog as { tool_quartiles?: Record<string, any[]> }).tool_quartiles?.[ref.sourceSlug as string] : undefined;
    return rows ? { tool, quartiles: rows } : null;
  })
  .filter((t): t is { tool: string; quartiles: any[] } => t !== null);
---

{quartiles && (
  <div
    class="bench-quartile"
    data-quartiles={JSON.stringify(quartiles)}
    data-extra-quartiles={extraTools.length ? JSON.stringify(extraTools) : ""}
  >
    <h3>Accuracy by intensity quartile</h3>
    <div class="bench-quartile-grid">
      {quartiles.map((item: any) => (
        <div class="bench-quartile-item">
          <div class="bench-quartile-species">{item.species}</div>
          <div data-chart={item.species} class="bench-plotly-target"></div>
        </div>
      ))}
    </div>
  </div>
)}

<script>
  import Plotly from "plotly.js-cartesian-dist-min";
  import { baseLayout, axisStyle, baseConfig, COLORS, SPECIES_COLORS, TOOL_COLORS } from "../../lib/plotlyTheme";

  const LOG2_TICKS = [-2, -1, 0, 1, 2];
  const LOG2_LABELS = ["0.25×", "0.5×", "1×", "2×", "4×"];

  const toolColor = (tool: string) => TOOL_COLORS[tool.toLowerCase().replace(/[^a-z]/g, "")] ?? COLORS.textLight;

  // Per-series horizontal offset (data units), keyed by how many series
  // share the same quartile x-position. The two-series values match what
  // shipped for DIA-NN alone — added tools extend the pattern rather than
  // renumbering it.
  const OFFSET_STEPS: Record<number, number[]> = {
    1: [0],
    2: [-0.08, 0.08],
    3: [-0.12, 0, 0.12],
  };

  function seriesFor(points: any[]) {
    return {
      medians: points.map((p) => p.median),
      upperErr: points.map((p) => p.upper - p.median),
      lowerErr: points.map((p) => p.median - p.lower),
    };
  }

  function lineTrace(name: string, x: number[], target: number, points: any[], color: string) {
    return {
      type: "scatter",
      mode: "lines+markers",
      name,
      x,
      y: x.map(() => target),
      error_y: { type: "data", symmetric: false, array: x.map(() => 0), arrayminus: x.map(() => 0), color, thickness: 1.5, width: 4 },
      line: { color, width: 2, simplify: false },
      marker: { color, size: 8 },
      text: points.map((p) => `${p.count_display} precursors`),
      hovertemplate: `${name} %{x}<br>median %{y:.2f} log₂<br>%{text}<extra></extra>`,
    };
  }

  document.querySelectorAll<HTMLElement>("[data-quartiles]").forEach((container) => {
    const quartiles = JSON.parse(container.dataset.quartiles!);
    const extraTools: { tool: string; quartiles: any[] }[] = container.dataset.extraQuartiles
      ? JSON.parse(container.dataset.extraQuartiles)
      : [];

    quartiles.forEach((item: any) => {
      const el = container.querySelector<HTMLElement>(`[data-chart="${item.species}"]`);
      if (!el) return;

      const labels = item.points.map((p: any) => p.quartile);
      const positions = labels.map((_: string, i: number) => i);
      const color = SPECIES_COLORS[item.species] ?? COLORS.primary;

      const extraItems = extraTools
        .map((t) => {
          const found = t.quartiles.find((d: any) => d.species === item.species);
          return found ? { tool: t.tool, item: found } : null;
        })
        .filter((t): t is { tool: string; item: any } => t !== null);

      const traces: any[] = [];
      const frames: any[] = [];

      if (extraItems.length > 0) {
        const allNames = ["SynapSpec", ...extraItems.map((t) => t.tool)];
        const n = allNames.length;
        const offsets = OFFSET_STEPS[n] ?? allNames.map((_, i) => (i - (n - 1) / 2) * 0.08);
        const allItems = [item, ...extraItems.map((t) => t.item)];

        allNames.forEach((name, i) => {
          const it = allItems[i];
          const series = seriesFor(it.points);
          traces.push(lineTrace(name, positions.map((p: number) => p + offsets[i]), it.target, it.points, toolColor(name)));
          frames.push({ y: series.medians, error_y: { array: series.upperErr, arrayminus: series.lowerErr } });
        });
      } else {
        const series = seriesFor(item.points);
        traces.push(lineTrace("SynapSpec", positions, item.target, item.points, color));
        frames.push({ y: series.medians, error_y: { array: series.upperErr, arrayminus: series.lowerErr } });
      }

      // Entrance animation: start every point flat on the expected-ratio line
      // (no error bars yet), then animate to the real measured median + IQR.
      // Only `scatter` traces get a smooth Plotly transition — bar/box traces
      // jump instantly — so this widget is the one place that's worth it.
      Plotly.newPlot(
        el,
        traces,
        baseLayout({
          xaxis: { ...axisStyle, showgrid: false, tickmode: "array", tickvals: positions, ticktext: labels },
          yaxis: { ...axisStyle, tickvals: LOG2_TICKS, ticktext: LOG2_LABELS, range: [-3, 2.25] },
          shapes: [
            {
              type: "line",
              xref: "paper",
              x0: 0,
              x1: 1,
              y0: item.target,
              y1: item.target,
              line: { color: COLORS.text, width: 1.5, dash: "dash" },
            },
          ],
          ...(extraItems.length > 0 ? { showlegend: true, legend: { orientation: "h", y: -0.3 } } : {}),
        }),
        baseConfig,
      ).then(() => {
        Plotly.animate(
          el,
          { data: frames },
          { transition: { duration: 600, easing: "cubic-in-out" }, frame: { duration: 600, redraw: false } },
        );
      });
    });
  });
</script>
