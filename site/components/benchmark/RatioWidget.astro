---
// _includes/benchmark/ratio-widget.html을 옮긴 것, Plotly로 재구현.
// No-JS 토글: 라디오 두 개가 CSS sibling selector로 패널을 바꾼다
// (_sass/_benchmark.scss의 .bench-ratio-panel-*). 두 모드 모두 페이지 로드 시
// 함께 그려두고, 보이는 것만 CSS로 바뀐다 — 탭 전환에 JS가 필요 없다.
//
// DIA-NN 참조가 있으면(같은 ledger 조회를 DiagnosticsWidget/ScatterWidget과
// 공유) 종별 점을 위아래로 살짝 띄워 두 tool을 나란히 보여준다. 값은
// instrumentation/parsers/lfq.py의 get_lfq_ratio_statistics와 같은 로직
// (median/25%/75%/count, deviation_percent)으로 DIA-NN의 report.parquet에서
// 직접 계산했다.
import catalog from "../../data/benchmark_catalog.json";
import ledgers from "../../data/benchmark_ledger.json";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const entry = catalog.recorded_runs[slug as keyof typeof catalog.recorded_runs];
const ratios = entry.ratio_measurements as any[];

const ledger = ledgers.find((l) => l.rows.some((r) => r.sourceSlug === slug));
const diannRef = ledger?.toolReferences.find((r) => r.tool === "DIA-NN" && r.sourceSlug);
const diannRatios = diannRef
  ? (catalog as { tool_ratios?: Record<string, any[]> }).tool_ratios?.[diannRef.sourceSlug as string]
  : undefined;
---

<input type="radio" name="ratio-mode" id="ratio-actual" class="bench-ratio-input" checked />
<input type="radio" name="ratio-mode" id="ratio-relative" class="bench-ratio-input" />

<div class="bench-ratio-head">
  <div>
    <h2>Expected and measured ratios</h2>
  </div>
  <div class="bench-toggle-group" role="group" aria-label="Ratio display">
    <label for="ratio-actual" class="bench-toggle-btn">Actual ratio</label>
    <label for="ratio-relative" class="bench-toggle-btn">Against expected</label>
  </div>
</div>

<div class="bench-ratio-panel bench-ratio-panel-actual">
  <div
    data-chart="ratio-actual"
    class="bench-plotly-target bench-plotly-fade"
    data-ratios={JSON.stringify(ratios)}
    data-diann-ratios={diannRatios ? JSON.stringify(diannRatios) : ""}
  ></div>
</div>

<div class="bench-ratio-panel bench-ratio-panel-relative">
  <div
    data-chart="ratio-relative"
    class="bench-plotly-target bench-plotly-fade"
    data-ratios={JSON.stringify(ratios)}
    data-diann-ratios={diannRatios ? JSON.stringify(diannRatios) : ""}
  ></div>
</div>


<script>
  import Plotly from "plotly.js-cartesian-dist-min";
  import { baseLayout, axisStyle, baseConfig, COLORS, SPECIES_COLORS, TOOL_COLORS, drawWhenVisible } from "../../lib/plotlyTheme";

  const LOG2_TICKS = [-2, -1, 0, 1, 2];
  const LOG2_LABELS = ["0.25×", "0.5×", "1×", "2×", "4×"];
  const DEV_TICKS = [-0.5, -0.25, 0, 0.25, 0.5];
  const DEV_LABELS = ["-50%", "-25%", "Expected", "+25%", "+50%"];

  function targetShapes(values: number[]) {
    return values.map((v, idx) => ({
      type: "line",
      xref: "x",
      yref: "y",
      x0: v,
      x1: v,
      y0: idx - 0.4,
      y1: idx + 0.4,
      line: { color: COLORS.textLight, width: 2, dash: "dash" },
    }));
  }

  // Numeric y positions (0, 1, 2 for the three species rows) instead of
  // category strings — with DIA-NN present, each tool's dot needs its own
  // small vertical offset off that row's center so the two don't sit on
  // top of each other. Bar/box traces get this "group" behavior from
  // Plotly for free; scatter doesn't, so it's done by hand here.
  function seriesFor(rows: any[], mode: "actual" | "relative") {
    const isActual = mode === "actual";
    return {
      lower: rows.map((r) => (isActual ? r.lower : r.lower - r.target)),
      median: rows.map((r) => (isActual ? r.median : r.median - r.target)),
      upper: rows.map((r) => (isActual ? r.upper : r.upper - r.target)),
      valueLabels: rows.map((r) =>
        isActual ? r.measured_ratio_display : `${r.deviation_percent > 0 ? "+" : ""}${r.deviation_percent}%`,
      ),
    };
  }

  function dotTrace(name: string, positions: number[], species: string[], rows: any[], series: ReturnType<typeof seriesFor>, color: string) {
    return {
      type: "scatter",
      mode: "markers",
      name,
      y: positions,
      x: series.median,
      customdata: species,
      error_x: {
        type: "data",
        symmetric: false,
        array: series.upper.map((v, i) => v - series.median[i]),
        arrayminus: series.median.map((v, i) => v - series.lower[i]),
        color,
        thickness: 4,
        width: 8,
      },
      marker: { color, size: 16, line: { color: COLORS.background, width: 2 } },
      text: rows.map((r) => `${r.measured_ratio_display} measured median A/B, ${r.count_display} paired precursors`),
      hovertemplate: `%{customdata} · ${name}<br>%{text}<extra></extra>`,
    };
  }

  function valueAnnotations(positions: number[], series: ReturnType<typeof seriesFor>, yshift: number) {
    return positions.map((pos, idx) => ({
      x: series.median[idx],
      y: pos,
      text: `<b>${series.valueLabels[idx]}</b>`,
      showarrow: false,
      yshift,
      font: { color: COLORS.text, size: 13 },
    }));
  }

  // Dot + horizontal bar instead of a box plot: a box's "rectangle with a
  // second line inside it" reads as two competing marks (median vs. quartile
  // edges) at a glance. One colored dot for the median plus a plain range bar
  // for the IQR, with the expected value called out separately in gray, is
  // the same information read more directly — "here's what we got, here's
  // what a bar plotted point closer to the target would look like."
  function renderPanel(el: HTMLElement, ratios: any[], diannRatios: any[] | null, mode: "actual" | "relative") {
    const species = ratios.map((r) => r.species);
    const positions = species.map((_, i) => i);
    const isActual = mode === "actual";
    const targetValues = isActual ? ratios.map((r) => r.target) : ratios.map(() => 0);

    const traces: any[] = [];
    const annotations: any[] = [];

    if (diannRatios) {
      const offset = 0.16;
      const synapPositions = positions.map((p) => p - offset);
      const diannPositions = positions.map((p) => p + offset);
      // DIA-NN rows aren't guaranteed the same species order as SynapSpec's
      // — match by species name rather than array index.
      const diannRows = species.map((label) => diannRatios.find((r: any) => r.species === label));

      const synapSeries = seriesFor(ratios, mode);
      const diannSeries = seriesFor(diannRows, mode);

      traces.push(dotTrace("SynapSpec", synapPositions, species, ratios, synapSeries, TOOL_COLORS.synapspec));
      traces.push(dotTrace("DIA-NN", diannPositions, species, diannRows, diannSeries, TOOL_COLORS.diann));
      annotations.push(...valueAnnotations(synapPositions, synapSeries, -20));
      annotations.push(...valueAnnotations(diannPositions, diannSeries, 20));
    } else {
      const colors = species.map((s) => SPECIES_COLORS[s] ?? COLORS.primary);
      const synapSeries = seriesFor(ratios, mode);
      traces.push({ ...dotTrace("SynapSpec", positions, species, ratios, synapSeries, COLORS.primaryDark), marker: { color: colors, size: 16, line: { color: COLORS.background, width: 2 } } });
      annotations.push(...valueAnnotations(positions, synapSeries, 26));
    }

    Plotly.newPlot(
      el,
      traces,
      baseLayout({
        xaxis: isActual
          ? { ...axisStyle, tickvals: LOG2_TICKS, ticktext: LOG2_LABELS, range: [-2.5, 1.5] }
          : { ...axisStyle, tickvals: DEV_TICKS, ticktext: DEV_LABELS, range: [-0.5, 0.5] },
        yaxis: { ...axisStyle, showgrid: false, tickmode: "array", tickvals: positions, ticktext: species, range: [-0.6, positions.length - 1 + 0.6] },
        shapes: targetShapes(targetValues),
        annotations,
        ...(diannRatios
          ? { showlegend: true, legend: { orientation: "h", y: -0.22 }, margin: { t: 20, r: 20, b: 70, l: 70 } }
          : { margin: { t: 20, r: 20, b: 40, l: 70 } }),
      }),
      baseConfig,
    ).then(() => el.classList.add("is-visible"));
  }

  document.querySelectorAll<HTMLElement>('[data-chart="ratio-actual"]').forEach((el) => {
    const diannRatios = el.dataset.diannRatios ? JSON.parse(el.dataset.diannRatios) : null;
    drawWhenVisible(el, () => renderPanel(el, JSON.parse(el.dataset.ratios!), diannRatios, "actual"));
  });
  document.querySelectorAll<HTMLElement>('[data-chart="ratio-relative"]').forEach((el) => {
    const diannRatios = el.dataset.diannRatios ? JSON.parse(el.dataset.diannRatios) : null;
    drawWhenVisible(el, () => renderPanel(el, JSON.parse(el.dataset.ratios!), diannRatios, "relative"));
  });
</script>
