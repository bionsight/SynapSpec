---
// _includes/benchmark/ratio-widget.html을 옮긴 것, Plotly로 재구현.
// No-JS 토글: 라디오 두 개가 CSS sibling selector로 패널을 바꾼다
// (_sass/_benchmark.scss의 .bench-ratio-panel-*). 두 모드 모두 페이지 로드 시
// 함께 그려두고, 보이는 것만 CSS로 바뀐다 — 탭 전환에 JS가 필요 없다.
import catalog from "../../data/benchmark_catalog.json";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const entry = catalog.recorded_runs[slug as keyof typeof catalog.recorded_runs];
const ratios = entry.ratio_measurements as any[];
---

<input type="radio" name="ratio-mode" id="ratio-actual" class="bench-ratio-input" checked />
<input type="radio" name="ratio-mode" id="ratio-relative" class="bench-ratio-input" />

<div class="bench-ratio-head">
  <div>
    <h2>Expected and measured ratios</h2>
    <p class="bench-axis-note" style="text-align: left;">Precursor-level LFQ · Human 1×, Yeast 2×, E. coli 0.25× A/B</p>
  </div>
  <div class="bench-toggle-group" role="group" aria-label="Ratio display">
    <label for="ratio-actual" class="bench-toggle-btn">Actual ratio</label>
    <label for="ratio-relative" class="bench-toggle-btn">Against expected</label>
  </div>
</div>

<p class="bench-axis-note" style="text-align: left; margin-bottom: 1rem;">Gray dashed line: expected ratio. Dot: measured median. Bar: middle 50% of measurements. A close median does not mean every measurement is close.</p>

<div class="bench-ratio-panel bench-ratio-panel-actual">
  <div data-chart="ratio-actual" class="bench-plotly-target bench-plotly-fade" data-ratios={JSON.stringify(ratios)}></div>
</div>

<div class="bench-ratio-panel bench-ratio-panel-relative">
  <div data-chart="ratio-relative" class="bench-plotly-target bench-plotly-fade" data-ratios={JSON.stringify(ratios)}></div>
</div>

<p class="bench-axis-note bench-ratio-footnote-actual" style="text-align: left;">Ratio A/B on a log₂-spaced axis: equal distances mean equal fold changes. The bar is the interquartile range, not a confidence interval.</p>
<p class="bench-axis-note bench-ratio-footnote-relative" style="text-align: left;">Measured A/B divided by expected A/B, on a closer log₂-spaced axis. The bar is the interquartile range, not a confidence interval.</p>

<script>
  import Plotly from "plotly.js-cartesian-dist-min";
  import { baseLayout, axisStyle, baseConfig, COLORS, SPECIES_COLORS } from "../../lib/plotlyTheme";

  const LOG2_TICKS = [-2, -1, 0, 1, 2];
  const LOG2_LABELS = ["0.25×", "0.5×", "1×", "2×", "4×"];
  const DEV_TICKS = [-0.5, -0.25, 0, 0.25, 0.5];
  const DEV_LABELS = ["-50%", "-25%", "Expected", "+25%", "+50%"];

  function targetShapes(values: number[]) {
    return values.map((v, idx) => ({
      type: "line",
      xref: "x",
      yref: "y",
      x0: v,
      x1: v,
      y0: idx - 0.4,
      y1: idx + 0.4,
      line: { color: COLORS.textLight, width: 2, dash: "dash" },
    }));
  }

  // Dot + horizontal bar instead of a box plot: a box's "rectangle with a
  // second line inside it" reads as two competing marks (median vs. quartile
  // edges) at a glance. One colored dot for the median plus a plain range bar
  // for the IQR, with the expected value called out separately in gray, is
  // the same information read more directly — "here's what we got, here's
  // what a bar plotted point closer to the target would look like."
  function renderPanel(el: HTMLElement, ratios: any[], mode: "actual" | "relative") {
    const species = ratios.map((r) => r.species);
    const colors = species.map((s) => SPECIES_COLORS[s] ?? COLORS.primary);
    const isActual = mode === "actual";

    const lower = ratios.map((r) => (isActual ? r.lower : r.lower - r.target));
    const median = ratios.map((r) => (isActual ? r.median : r.median - r.target));
    const upper = ratios.map((r) => (isActual ? r.upper : r.upper - r.target));
    const targetValues = isActual ? ratios.map((r) => r.target) : ratios.map(() => 0);
    const valueLabels = ratios.map((r) =>
      isActual ? r.measured_ratio_display : `${r.deviation_percent > 0 ? "+" : ""}${r.deviation_percent}%`,
    );

    Plotly.newPlot(
      el,
      [
        {
          type: "scatter",
          mode: "markers",
          orientation: "h",
          y: species,
          x: median,
          error_x: {
            type: "data",
            symmetric: false,
            array: upper.map((v, i) => v - median[i]),
            arrayminus: median.map((v, i) => v - lower[i]),
            color: COLORS.primaryDark,
            thickness: 4,
            width: 8,
          },
          marker: { color: colors, size: 16, line: { color: COLORS.background, width: 2 } },
          text: ratios.map((r) => `${r.measured_ratio_display} measured median A/B, ${r.count_display} paired precursors`),
          hovertemplate: "%{y}<br>%{text}<extra></extra>",
        },
      ],
      baseLayout({
        xaxis: isActual
          ? { ...axisStyle, tickvals: LOG2_TICKS, ticktext: LOG2_LABELS, range: [-2.5, 1.5] }
          : { ...axisStyle, tickvals: DEV_TICKS, ticktext: DEV_LABELS, range: [-0.5, 0.5] },
        yaxis: { ...axisStyle, showgrid: false },
        shapes: targetShapes(targetValues),
        annotations: species.map((label, idx) => ({
          x: median[idx],
          y: label,
          text: `<b>${valueLabels[idx]}</b>`,
          showarrow: false,
          yshift: 26,
          font: { color: COLORS.text, size: 13 },
        })),
        margin: { t: 20, r: 20, b: 40, l: 70 },
      }),
      baseConfig,
    ).then(() => el.classList.add("is-visible"));
  }

  document.querySelectorAll<HTMLElement>('[data-chart="ratio-actual"]').forEach((el) => {
    renderPanel(el, JSON.parse(el.dataset.ratios!), "actual");
  });
  document.querySelectorAll<HTMLElement>('[data-chart="ratio-relative"]').forEach((el) => {
    renderPanel(el, JSON.parse(el.dataset.ratios!), "relative");
  });
</script>
