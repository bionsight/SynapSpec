---
// _includes/benchmark/recorded.html을 옮긴 것. kind: recorded인 항목에서 쓴다.
// catalog.recorded_runs 는 slug로 찾는 맵 — 여러 데이터셋(astral, oe480, ...)을 공유한다.
import catalog from "../../data/benchmark_catalog.json";
import RatioWidget from "./RatioWidget.astro";
import QuartileWidget from "./QuartileWidget.astro";
import DiagnosticsWidget from "./DiagnosticsWidget.astro";
import ScatterWidget from "./ScatterWidget.astro";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const entry = catalog.recorded_runs[slug as keyof typeof catalog.recorded_runs];
const run = entry.recorded_run;
// Only the release-tag-pinned runs have per-run diagnostics recorded so far.
const diagnostics = (entry as { diagnostics?: unknown }).diagnostics;
---

<div class="container">
  <div class="breadcrumbs">
    <a href="/benchmarks/">&larr; Benchmarks</a> / Run detail
  </div>

  <div class="page-header bench-header-split">
    <div>
      <h1>{entry.title} <span class="bench-muted">/ {entry.instrument}</span></h1>
    </div>
    <a href="/benchmarks/history/" class="bench-link">Dataset history</a>
  </div>

  <dl class="bench-facts bench-facts-top">
    <div><dt>Release</dt><dd>Not mapped</dd></div>
    <div><dt>Run date</dt><dd>{run.date}</dd></div>
    <div><dt>Elapsed time</dt><dd>{run.runtime_display}</dd></div>
    <div><dt>Resource</dt><dd>{run.instance}</dd></div>
  </dl>

  <nav class="bench-section-nav" aria-label="Run sections">
    {diagnostics && <a href="#diagnostic-plots">Diagnostic plots</a>}<a href="#lfq-metrics">LFQ metrics</a><a href="#configuration">Configuration</a><a href="#raw-files">Raw files</a><a href="#source-record">Source record</a>
  </nav>

  {diagnostics && (
    <section id="diagnostic-plots" class="py-lg bench-border-t">
      <h2>Diagnostic plots</h2>
      <div class="bench-diagnostic-plots-stack">
        <DiagnosticsWidget slug={slug} />
        <ScatterWidget slug={slug} />
      </div>
    </section>
  )}

  <section id="lfq-metrics" class="py-lg bench-border-t">
    <RatioWidget slug={slug} />
    <QuartileWidget slug={slug} />
  </section>

  <section id="configuration" class="py-lg bench-border-t">
    <h2>Run configuration</h2>
    <dl class="bench-config-grid">
      {entry.recorded_config.map((pair) => <div><dt>{pair[0]}</dt><dd>{pair[1]}</dd></div>)}
    </dl>
    <details class="bench-details">
      <summary>Additional recorded settings</summary>
      <p>FASTA: {entry.fasta}</p>
      <p>Differential analysis enabled · condition-aware precursor correction on · quantity level: pg · output: parquet.</p>
    </details>
  </section>

  <section id="raw-files" class="py-lg bench-border-t">
    <h2>Raw files</h2>
    <div class="bench-table-wrap">
      <table class="bench-table">
        <thead>
          <tr><th>File name</th><th>Condition</th><th>Replicate</th><th class="num">Precursor IDs</th><th class="num">Protein accessions</th></tr>
        </thead>
        <tbody>
          {run.files.map((file) => (
            <tr>
              <th scope="row"><code>{file.name}</code></th>
              <td>{file.condition}</td>
              <td>{file.replicate}</td>
              <td class="num">{file.precursors_display}</td>
              <td class="num">{file.proteins_display}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="source-record" class="py-lg bench-border-t">
    <h2>Source record</h2>
    <a href="/benchmarks/" class="bench-link">All datasets</a>
  </section>
</div>
