---
// _includes/benchmark/recorded.html을 옮긴 것. kind: recorded인 항목에서 쓴다.
// catalog.recorded_runs 는 slug로 찾는 맵 — 여러 데이터셋(astral, oe480, ...)을 공유한다.
import catalog from "../../data/benchmark_catalog.json";
import RunConfiguration from "./RunConfiguration.astro";
import QuartileWidget from "./QuartileWidget.astro";
import DiagnosticsWidget from "./DiagnosticsWidget.astro";
import DensityWidget from "./DensityWidget.astro";
import ScatterWidget from "./ScatterWidget.astro";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const entry = catalog.recorded_runs[slug as keyof typeof catalog.recorded_runs];
const run = entry.recorded_run;
// Only the release-tag-pinned runs have per-run diagnostics recorded so far.
const diagnostics = (entry as { diagnostics?: unknown }).diagnostics;
// Same population that gets a quartile chart also has the density plot;
// runs without it (no per-run diagnostics computed) skip this section
// entirely rather than rendering an empty one.
const quartiles = (entry as { quartile_measurements?: unknown }).quartile_measurements;
// Only the PXD028735 runs have a public source record (PRIDE) on file.
// ProteoBench/Astral doesn't have one we know of yet, so for now it just
// skips the raw-files/source-record area entirely rather than showing a
// stale table or a dead link.
const sourceUrl = (entry as { source_url?: string }).source_url;
---

<div class="container">
  <div class="breadcrumbs">
    <a href="/benchmarks/">&larr; Benchmarks</a> / Run detail
  </div>

  <div class="page-header">
    <h1>{entry.title} <span class="bench-muted">/ {entry.instrument}</span></h1>
  </div>

  <p class="bench-run-date">{run.date}</p>

  <div class="recorded-benchmark-container">
      {diagnostics && (
        <section id="diagnostic-plots">
          <p class="bench-scatter-compare-label">Diagnostic plots</p>
          <div class="recorded-benchmark-container">
            <DiagnosticsWidget slug={slug} />
            <DensityWidget slug={slug} />
          </div>
        </section>
      )}

      <!-- {quartiles && (
        <section id="lfq-metrics" class="py-lg bench-border-t">
          <QuartileWidget slug={slug} />
        </section>
      )} -->

      {diagnostics && (
        <section id="lfq-scatter">
          <ScatterWidget slug={slug} />
        </section>
      )}
  </div>


  <RunConfiguration settings={entry.recorded_config}>
    <details class="bench-details">
      <summary>Additional recorded settings</summary>
      <p>FASTA: {entry.fasta}</p>
      <p>Differential analysis enabled · condition-aware precursor correction on · quantity level: pg · output: parquet.</p>
    </details>
  </RunConfiguration>

  {sourceUrl && (
    <section id="raw-files" class="pb-lg">
      <a href={sourceUrl} class="bench-link" target="_blank" rel="noopener">Raw files: {entry.title} on PRIDE Archive ↗</a>
    </section>
  )}
</div>
