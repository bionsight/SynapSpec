---
// _includes/benchmark/recorded.html을 옮긴 것. kind: recorded인 항목 하나
// (2026-09-07-5d12a532)에서만 쓴다.
import catalog from "../../data/benchmark_catalog.json";
import RatioWidget from "./RatioWidget.astro";

const run = catalog.recorded_run;
---

<div class="container">
  <div class="breadcrumbs">
    <a href="/benchmarks/">&larr; Benchmarks</a> / Run detail
  </div>

  <div class="page-header bench-header-split">
    <div>
      <h1>LFQBench <span class="bench-muted">/ Orbitrap Astral</span></h1>
      <p class="section-subtitle">A &times; 3 + B &times; 3 · completed run · <code>5d12a532</code></p>
    </div>
    <a href="/benchmarks/history/" class="bench-link">Dataset history</a>
  </div>

  <dl class="bench-facts bench-facts-top">
    <div><dt>Release</dt><dd>Not mapped<span class="bench-fact-note">Commit 5d12a532</span></dd></div>
    <div><dt>Run date</dt><dd>{run.date}<span class="bench-fact-note">00:59–06:28 · ClearML display</span></dd></div>
    <div><dt>Elapsed time</dt><dd>{run.runtime_display}<span class="bench-fact-note">Task wall-clock time</span></dd></div>
    <div><dt>Resource</dt><dd>{run.instance}<span class="bench-fact-note">Instance tag, not host capacity</span></dd></div>
  </dl>

  <nav class="bench-section-nav" aria-label="Run sections">
    <a href="#configuration">Configuration</a><a href="#raw-files">Raw files</a><a href="#lfq-metrics">LFQ metrics</a><a href="#source-record">Source record</a>
  </nav>

  <section id="configuration" class="py-lg bench-border-t">
    <h2>Run configuration</h2>
    <p class="bench-axis-note" style="text-align: left;">Recorded configuration · bion_lfq_astral.yaml</p>
    <dl class="bench-config-grid">
      {catalog.recorded_config.map((pair) => <div><dt>{pair[0]}</dt><dd>{pair[1]}</dd></div>)}
    </dl>
    <details class="bench-details">
      <summary>Additional recorded settings</summary>
      <p>FASTA: napedro_3mixed_human_yeast_ecoli_20140403_iRT.fasta</p>
      <p>Differential analysis enabled · condition-aware precursor correction on · quantity level: pg · output: parquet.</p>
      <p>Only explicitly recorded settings are shown. FDR thresholds and release mapping have not been verified for this run.</p>
    </details>
  </section>

  <section id="raw-files" class="py-lg bench-border-t">
    <h2>Raw files</h2>
    <p class="bench-axis-note" style="text-align: left; margin-bottom: 1.25rem;">Six input files · protein column uses per-file protein_accessions</p>
    <div class="bench-table-wrap">
      <table class="bench-table">
        <thead>
          <tr><th>File name</th><th>Condition</th><th>Replicate</th><th class="num">Precursor IDs</th><th class="num">Protein accessions</th></tr>
        </thead>
        <tbody>
          {run.files.map((file) => (
            <tr>
              <th scope="row"><code>{file.name}</code></th>
              <td>{file.condition}</td>
              <td>{file.replicate}</td>
              <td class="num">{file.precursors_display}</td>
              <td class="num">{file.proteins_display}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="bench-axis-note" style="text-align: left;">Across the analysis: {run.total_precursors_display} distinct precursors; {run.total_proteins_display} reported total_proteins. These are not sums of the rows. Protein counting scopes differ. File sizes and acquisition durations have not been imported.</p>
  </section>

  <section id="lfq-metrics" class="py-lg bench-border-t">
    <RatioWidget />
  </section>

  <section id="source-record" class="py-lg bench-border-t">
    <h2>Source record</h2>
    <p class="bench-axis-note" style="text-align: left;">ClearML run at commit 5d12a532, checked on 7 September 2026. Date and time retain the source display; its timezone has not been established. Resource describes the recorded instance tag.</p>
    <p class="bench-axis-note" style="text-align: left;">Ratios use mean quantity in A divided by mean quantity in B for each precursor with positive quantities in both conditions. Quartiles and medians below are transformed from logged log₂ ratios. One run does not establish performance on other datasets or a ranking against other tools.</p>
    <a href="/benchmarks/" class="bench-link">All datasets</a>
  </section>
</div>
