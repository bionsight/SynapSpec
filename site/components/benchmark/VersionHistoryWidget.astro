---
// Replaces the old Run history table (then a bar chart, then stat cards) for
// `benchmarks/index.astro`. Landed back on a table — this reads as a
// leaderboard more naturally than cards do at three rows, and stays compact
// if more releases get added later. Only difference from a plain table: the
// DIA-NN/Spectronaut comparison isn't a column (it'd be "—" in every row but
// one). It's a speech-bubble tooltip anchored to the precursor count,
// revealed on hover of that count (or focus of the row, for keyboard) —
// pure CSS, no JS.
interface Row {
  date: string | null;
  label: string;
  sourceSlug: string;
  counts: (number | null)[];
  counts_display: (string | null)[];
  runtime: number | null;
  resource: string | null;
  release_version: string | null;
}
interface ToolReference {
  tool: string;
  value: number | null;
  display: string | null;
  date: string | null;
  sourceSlug: string | null;
}
interface Props {
  rows: Row[];
  toolReferences: ToolReference[];
}
const { rows, toolReferences } = Astro.props;

const references = toolReferences.filter((ref): ref is ToolReference & { value: number; display: string } => ref.value !== null);
---

<table class="bench-table bench-version-table">
  <thead>
    <tr><th>Release</th><th class="num">SynapSpec precursor IDs</th></tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr>
        <th scope="row"><a href={`/benchmarks/${row.sourceSlug}/`} class="bench-link">{row.release_version ?? row.date ?? "Undated"}</a></th>
        <td class="num">
          <span class="bench-version-value-wrap">
            {row.counts_display[0] ?? "—"}
            {references.length > 0 && (
              <span class="bench-version-compare" role="tooltip">
                {references.map((ref, i) => (
                  <>
                    {i > 0 && " · "}
                    <span class={`bench-tool bench-tool-${ref.tool.toLowerCase().replace(/[^a-z]/g, "")}`}>{ref.tool} {ref.display}</span>
                  </>
                ))}
              </span>
            )}
          </span>
        </td>
      </tr>
    ))}
  </tbody>
</table>
