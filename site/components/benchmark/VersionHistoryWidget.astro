---
// Run history for `benchmarks/index.astro`: a bar chart of SynapSpec's own
// precursor counts by release, reading as its own track record first — no
// DIA-NN/Spectronaut line drawn on load. A button below the chart
// ("Compare with DIA-NN") toggles a dashed reference line + label via
// Plotly.relayout (same shapes/annotations pattern ComparisonWidget's ratio
// charts use for "Expected"), so nothing redraws from scratch. Clicking a
// bar opens that run's detail page.
interface Row {
  date: string | null;
  label: string;
  sourceSlug: string;
  counts: (number | null)[];
  counts_display: (string | null)[];
  runtime: number | null;
  resource: string | null;
  release_version: string | null;
}
interface ToolReference {
  tool: string;
  value: number | null;
  display: string | null;
  date: string | null;
  sourceSlug: string | null;
}
interface Props {
  rows: Row[];
  toolReferences: ToolReference[];
}
const { rows, toolReferences } = Astro.props;

const usableReferences = toolReferences.filter((ref): ref is ToolReference & { value: number; display: string; sourceSlug: string } => ref.value !== null);
---

<div class="bench-version-chart-block" data-rows={JSON.stringify(rows)} data-references={JSON.stringify(usableReferences)}>
  <div data-chart="versions" class="bench-plotly-target bench-plotly-fade"></div>
  {usableReferences.length > 0 && (
    <button type="button" class="bench-version-compare-btn" data-compare-toggle aria-pressed="false">
      Compare with {usableReferences.map((r) => r.tool).join(" & ")}
    </button>
  )}
</div>

<script>
  import Plotly from "plotly.js-cartesian-dist-min";
  import { baseLayout, axisStyle, baseConfig, COLORS, TOOL_COLORS, drawWhenVisible } from "../../lib/plotlyTheme";

  const toolColor = (tool: string) => TOOL_COLORS[tool.toLowerCase().replace(/[^a-z]/g, "")] ?? COLORS.textLight;

  document.querySelectorAll<HTMLElement>("[data-rows]").forEach((container) => {
    const rows: any[] = JSON.parse(container.dataset.rows!);
    const references: any[] = JSON.parse(container.dataset.references!);
    const el = container.querySelector<HTMLElement>('[data-chart="versions"]');
    const toggle = container.querySelector<HTMLButtonElement>("[data-compare-toggle]");
    if (!el) return;

    // Rows arrive newest-first; the chart reads left-to-right as a
    // timeline, so oldest first.
    const chartRows = [...rows].reverse();
    const labels = chartRows.map((r) => r.release_version ?? r.date ?? "—");
    const values = chartRows.map((r) => r.counts[0]);
    const displays = chartRows.map((r) => r.counts_display[0]);
    const sourceSlugs = chartRows.map((r) => r.sourceSlug);
    const customdata = chartRows.map((r) => [
      r.date ?? "—",
      r.runtime ? `${Math.round(r.runtime * 100) / 100} h` : "—",
      r.resource ?? "—",
    ]);

    // Fixed numeric slots instead of a categorical axis, so bars stay a
    // constant narrow width and pack against the left — the empty slots on
    // the right read as "more runs land here", not as a chart that's
    // already full.
    const positions = chartRows.map((_, i) => i);
    const reservedSlots = Math.max(chartRows.length + 4, 8);
    const barWidth = 0.45;

    // A dashed-outline "ghost" bar right after the last real run, taller
    // than the rest with an arrow annotation — makes the empty slots read
    // as "the next run lands here" instead of just trailing off.
    const ghostPosition = chartRows.length;

    // Headroom reserved for the tallest reference line and the ghost bar up
    // front, so toggling the reference line on never rescales the y-axis
    // under the SynapSpec bars.
    const allValues = [...values, ...references.map((r) => r.value)].filter((v) => typeof v === "number");
    const maxVal = Math.max(...allValues, 0);
    const ghostHeight = maxVal * 1.08;
    const yMax = maxVal * 1.4;

    const ghostAnnotation = {
      x: ghostPosition,
      y: ghostHeight,
      xref: "x",
      yref: "y",
      text: "Next run will be soon",
      showarrow: true,
      arrowhead: 2,
      arrowsize: 1,
      arrowwidth: 1,
      arrowcolor: COLORS.textLight,
      standoff: 10,
      ax: 40,
      ay: -30,
      font: { size: 11, color: COLORS.textLight },
    };

    // Bar traces don't support a dashed marker outline in Plotly.js — a
    // shape rectangle does, so the ghost bar is a shape, not a trace.
    const ghostShape = {
      type: "rect",
      xref: "x",
      x0: ghostPosition - barWidth / 2,
      x1: ghostPosition + barWidth / 2,
      yref: "y",
      y0: 0,
      y1: ghostHeight,
      line: { color: COLORS.textLight, width: 1.5, dash: "dash" },
      fillcolor: "rgba(0,0,0,0)",
    };

    const referenceShapes = references.map((ref) => ({
      type: "line",
      xref: "paper",
      x0: 0,
      x1: 1,
      yref: "y",
      y0: ref.value,
      y1: ref.value,
      line: { color: toolColor(ref.tool), width: 1.5, dash: "dash" },
    }));
    const referenceAnnotations = references.map((ref) => ({
      x: 0,
      xref: "paper",
      xanchor: "left",
      y: ref.value,
      text: `${ref.tool} ${ref.display}`,
      showarrow: false,
      yshift: 10,
      font: { size: 11, color: toolColor(ref.tool) },
    }));

    drawWhenVisible(el, () => {
      Plotly.newPlot(
        el,
        [
          {
            type: "bar",
            x: positions,
            y: values,
            width: barWidth,
            text: displays,
            textposition: "outside",
            customdata,
            marker: { color: TOOL_COLORS.synapspec },
            hovertemplate: "%{text} precursor IDs<br>%{customdata[0]} · %{customdata[1]} · %{customdata[2]}<extra></extra>",
          },
          {
            // Invisible bar over the ghost shape, just to give it a hover
            // hit target — real bars are a Plotly trace so they get pointer
            // cursor + tooltip for free; the ghost is a shape, so it needs
            // this to behave the same way on hover.
            type: "bar",
            x: [ghostPosition],
            y: [ghostHeight],
            width: barWidth,
            marker: { color: "rgba(0,0,0,0)" },
            hovertemplate: "Next run — check back soon<extra></extra>",
            showlegend: false,
          },
        ],
        baseLayout({
          xaxis: {
            ...axisStyle,
            title: { text: "SynapSpec release" },
            showgrid: false,
            zeroline: false,
            tickmode: "array",
            tickvals: positions,
            ticktext: labels,
            range: [-0.75, reservedSlots - 0.25],
          },
          yaxis: { ...axisStyle, title: { text: "Precursor IDs" }, range: [0, yMax] },
          shapes: [ghostShape],
          annotations: [ghostAnnotation],
          // Plotly's default dragmode ("zoom") puts its own drag-rect layer on
          // top with an inline crosshair cursor, which wins over the pointer
          // cursor set on hover below. This chart isn't zoomable, so turn it
          // off rather than fight the layering.
          dragmode: false,
        }),
        baseConfig,
      ).then((gd: any) => {
        el.classList.add("is-visible");

        gd.on("plotly_hover", () => { el.style.cursor = "pointer"; });
        gd.on("plotly_unhover", () => { el.style.cursor = ""; });
        gd.on("plotly_click", (event: any) => {
          const point = event.points?.[0];
          if (!point || point.curveNumber !== 0) return;
          const slug = sourceSlugs[point.pointIndex];
          if (slug) window.location.href = `/benchmarks/${slug}/`;
        });

        toggle?.addEventListener("click", () => {
          const active = toggle.getAttribute("aria-pressed") === "true";
          toggle.setAttribute("aria-pressed", active ? "false" : "true");
          Plotly.relayout(
            el,
            active
              ? { shapes: [ghostShape], annotations: [ghostAnnotation] }
              : { shapes: [ghostShape, ...referenceShapes], annotations: [ghostAnnotation, ...referenceAnnotations] },
          );
        });
      });
    });
  });
</script>
