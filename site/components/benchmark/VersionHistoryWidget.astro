---
// Run history for `benchmarks/index.astro`: a bar chart of SynapSpec's own
// precursor counts by release. Defaults to SynapSpec-only bars — reads as
// its own track record first — and a <select> lets the visitor overlay a
// DIA-NN/Spectronaut reference line on demand, redrawn via Plotly.relayout
// on `change` (same dashed-line-plus-label shapes/annotations
// ComparisonWidget's ratio charts use for "Expected"). Clicking a bar opens
// that run's detail page — this used to be a separate table of the same
// numbers with the links; the chart is the whole thing now.
interface Row {
  date: string | null;
  label: string;
  sourceSlug: string;
  counts: (number | null)[];
  counts_display: (string | null)[];
  runtime: number | null;
  resource: string | null;
  release_version: string | null;
}
interface ToolReference {
  tool: string;
  value: number | null;
  display: string | null;
  date: string | null;
  sourceSlug: string | null;
}
interface Props {
  id: string;
  rows: Row[];
  toolReferences: ToolReference[];
}
const { id, rows, toolReferences } = Astro.props;

const selectId = `bench-compare-select-${id}`;
---

<div class="bench-version-chart-block" data-rows={JSON.stringify(rows)} data-references={JSON.stringify(toolReferences)}>
  <div class="bench-version-chart-controls">
    <label for={selectId}>Compare with</label>
    <select id={selectId} class="bench-version-select" data-compare-select>
      <option value="">SynapSpec only</option>
      {toolReferences.map((ref) => (
        <option value={ref.tool} disabled={ref.value === null}>{ref.tool}{ref.value === null ? " (no run recorded)" : ""}</option>
      ))}
    </select>
  </div>
  <div data-chart="versions" class="bench-plotly-target bench-plotly-fade"></div>
</div>

<script>
  import Plotly from "plotly.js-cartesian-dist-min";
  import { baseLayout, axisStyle, baseConfig, COLORS, TOOL_COLORS, drawWhenVisible } from "../../lib/plotlyTheme";

  const toolColor = (tool: string) => TOOL_COLORS[tool.toLowerCase().replace(/[^a-z]/g, "")] ?? COLORS.textLight;

  document.querySelectorAll<HTMLElement>("[data-rows]").forEach((container) => {
    const rows: any[] = JSON.parse(container.dataset.rows!);
    const references: any[] = JSON.parse(container.dataset.references!);
    const el = container.querySelector<HTMLElement>('[data-chart="versions"]');
    const select = container.querySelector<HTMLSelectElement>("[data-compare-select]");
    if (!el) return;

    // Rows arrive newest-first; the chart reads left-to-right as a
    // timeline, so oldest first.
    const chartRows = [...rows].reverse();
    const labels = chartRows.map((r) => r.release_version ?? r.date ?? "—");
    const values = chartRows.map((r) => r.counts[0]);
    const displays = chartRows.map((r) => r.counts_display[0]);
    const sourceSlugs = chartRows.map((r) => r.sourceSlug);
    const customdata = chartRows.map((r) => [
      r.date ?? "—",
      r.runtime ? `${Math.round(r.runtime * 100) / 100} h` : "—",
      r.resource ?? "—",
    ]);

    const usableRefs = references.filter((r) => r.value !== null);
    // Headroom reserved for the tallest possible reference line up front, so
    // picking a tool from the select doesn't rescale the y-axis under it.
    const allValues = [...values, ...usableRefs.map((r) => r.value)].filter((v) => typeof v === "number");
    const maxVal = Math.max(...allValues, 0);
    const yMax = maxVal * 1.2;

    const shapesFor = (tool: string) => {
      const ref = usableRefs.find((r) => r.tool === tool);
      if (!ref) return { shapes: [], annotations: [] };
      return {
        shapes: [
          {
            type: "line",
            xref: "paper",
            x0: 0,
            x1: 1,
            yref: "y",
            y0: ref.value,
            y1: ref.value,
            line: { color: toolColor(ref.tool), width: 1.5, dash: "dash" },
          },
        ],
        annotations: [
          {
            x: 0,
            xref: "paper",
            xanchor: "left",
            y: ref.value,
            text: `${ref.tool} ${ref.display}`,
            showarrow: false,
            yshift: 10,
            font: { size: 11, color: toolColor(ref.tool) },
          },
        ],
      };
    };

    drawWhenVisible(el, () => {
      Plotly.newPlot(
        el,
        [
          {
            type: "bar",
            x: labels,
            y: values,
            text: displays,
            textposition: "outside",
            customdata,
            marker: { color: TOOL_COLORS.synapspec },
            hovertemplate: "%{text} precursor IDs<br>%{customdata[0]} · %{customdata[1]} · %{customdata[2]}<extra></extra>",
          },
        ],
        baseLayout({
          xaxis: { ...axisStyle, title: { text: "SynapSpec release" }, showgrid: false },
          yaxis: { ...axisStyle, title: { text: "Precursor IDs" }, range: [0, yMax] },
        }),
        baseConfig,
      ).then((gd: any) => {
        el.classList.add("is-visible");
        select?.addEventListener("change", () => {
          const { shapes, annotations } = shapesFor(select.value);
          Plotly.relayout(el, { shapes, annotations });
        });

        // Bars link to that run's detail page — pointer cursor only while
        // actually over a bar, not the chart's padding/axes.
        gd.on("plotly_hover", () => { el.style.cursor = "pointer"; });
        gd.on("plotly_unhover", () => { el.style.cursor = ""; });
        gd.on("plotly_click", (event: any) => {
          const point = event.points?.[0];
          if (!point) return;
          const slug = sourceSlugs[point.pointIndex];
          if (slug) window.location.href = `/benchmarks/${slug}/`;
        });
      });
    });
  });
</script>
