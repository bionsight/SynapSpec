---
// Run history for `benchmarks/index.astro`: a bar chart of SynapSpec's own
// precursor counts by release, reading as its own track record first — no
// DIA-NN/Spectronaut bar drawn on load. Hovering (or focusing, for
// keyboard) a bar reveals that tool's bar right next to it via
// Plotly.restyle on a second, initially-all-null trace in barmode "group" —
// nothing gets redrawn from scratch. Clicking a bar (SynapSpec's or a
// revealed reference's) opens that run's detail page.
interface Row {
  date: string | null;
  label: string;
  sourceSlug: string;
  counts: (number | null)[];
  counts_display: (string | null)[];
  runtime: number | null;
  resource: string | null;
  release_version: string | null;
}
interface ToolReference {
  tool: string;
  value: number | null;
  display: string | null;
  date: string | null;
  sourceSlug: string | null;
}
interface Props {
  rows: Row[];
  toolReferences: ToolReference[];
}
const { rows, toolReferences } = Astro.props;

const usableReferences = toolReferences.filter((ref): ref is ToolReference & { value: number; display: string; sourceSlug: string } => ref.value !== null);
---

<div class="bench-version-chart-block" data-rows={JSON.stringify(rows)} data-references={JSON.stringify(usableReferences)}>
  {usableReferences.length > 0 && (
    <p class="bench-axis-note" style="text-align: left;">Hover a bar to compare with {usableReferences.map((r) => r.tool).join(" & ")}.</p>
  )}
  <div data-chart="versions" class="bench-plotly-target bench-plotly-fade"></div>
</div>

<script>
  import Plotly from "plotly.js-cartesian-dist-min";
  import { baseLayout, axisStyle, baseConfig, COLORS, TOOL_COLORS, drawWhenVisible } from "../../lib/plotlyTheme";

  const toolColor = (tool: string) => TOOL_COLORS[tool.toLowerCase().replace(/[^a-z]/g, "")] ?? COLORS.textLight;

  document.querySelectorAll<HTMLElement>("[data-rows]").forEach((container) => {
    const rows: any[] = JSON.parse(container.dataset.rows!);
    const references: any[] = JSON.parse(container.dataset.references!);
    const el = container.querySelector<HTMLElement>('[data-chart="versions"]');
    if (!el) return;

    // Rows arrive newest-first; the chart reads left-to-right as a
    // timeline, so oldest first.
    const chartRows = [...rows].reverse();
    const labels = chartRows.map((r) => r.release_version ?? r.date ?? "—");
    const values = chartRows.map((r) => r.counts[0]);
    const displays = chartRows.map((r) => r.counts_display[0]);
    const sourceSlugs = chartRows.map((r) => r.sourceSlug);
    const customdata = chartRows.map((r) => [
      r.date ?? "—",
      r.runtime ? `${Math.round(r.runtime * 100) / 100} h` : "—",
      r.resource ?? "—",
    ]);
    const hiddenRefY = () => labels.map(() => null);

    // Headroom reserved for every reference bar up front, so revealing one
    // on hover never rescales the y-axis under the SynapSpec bars.
    const allValues = [...values, ...references.map((r) => r.value)].filter((v) => typeof v === "number");
    const maxVal = Math.max(...allValues, 0);
    const yMax = maxVal * 1.2;

    const traces: any[] = [
      {
        type: "bar",
        name: "SynapSpec",
        x: labels,
        y: values,
        text: displays,
        textposition: "outside",
        customdata,
        marker: { color: TOOL_COLORS.synapspec },
        hovertemplate: "SynapSpec %{text} precursor IDs<br>%{customdata[0]} · %{customdata[1]} · %{customdata[2]}<extra></extra>",
      },
      ...references.map((ref) => ({
        type: "bar",
        name: ref.tool,
        x: labels,
        y: hiddenRefY(),
        text: hiddenRefY(),
        textposition: "outside",
        marker: { color: toolColor(ref.tool) },
        hovertemplate: `${ref.tool} %{text} precursor IDs<extra></extra>`,
      })),
    ];

    drawWhenVisible(el, () => {
      Plotly.newPlot(
        el,
        traces,
        baseLayout({
          barmode: "group",
          xaxis: { ...axisStyle, title: { text: "SynapSpec release" }, showgrid: false },
          yaxis: { ...axisStyle, title: { text: "Precursor IDs" }, range: [0, yMax] },
        }),
        baseConfig,
      ).then((gd: any) => {
        el.classList.add("is-visible");

        const reveal = (index: number) => {
          references.forEach((ref, i) => {
            const y = labels.map((_: unknown, li: number) => (li === index ? ref.value : null));
            const text = labels.map((_: unknown, li: number) => (li === index ? ref.display : null));
            Plotly.restyle(el, { y: [y], text: [text] }, [i + 1]);
          });
        };
        const hide = () => {
          references.forEach((_, i) => Plotly.restyle(el, { y: [hiddenRefY()], text: [hiddenRefY()] }, [i + 1]));
        };

        gd.on("plotly_hover", (event: any) => {
          const point = event.points?.[0];
          if (!point) return;
          el.style.cursor = "pointer";
          if (references.length > 0) reveal(point.pointIndex);
        });
        gd.on("plotly_unhover", () => {
          el.style.cursor = "";
          if (references.length > 0) hide();
        });
        gd.on("plotly_click", (event: any) => {
          const point = event.points?.[0];
          if (!point) return;
          if (point.curveNumber === 0) {
            const slug = sourceSlugs[point.pointIndex];
            if (slug) window.location.href = `/benchmarks/${slug}/`;
          } else {
            const ref = references[point.curveNumber - 1];
            if (ref?.sourceSlug) window.location.href = `/benchmarks/${ref.sourceSlug}/`;
          }
        });
      });
    });
  });
</script>
