---
// Replaces the old Run history table (and, before that, a bar chart) for
// `benchmarks/index.astro`. The team wants this section to read as
// SynapSpec's own leaderboard-style track record first — a bar chart still
// puts a number in front of every visitor before they've asked for it, so
// this is plain stat cards instead. Each card is itself the link to that
// run's detail page (no separate "Runs:" line needed).
//
// The DIA-NN/Spectronaut comparison is opt-in per card: it sits behind the
// precursor count and only shows on hover/focus of that count, via a plain
// CSS sibling selector (`.bench-version-card-compare` is empty height,
// `opacity: 0` until its preceding sibling is `:hover`/`:focus`) — no JS,
// works with keyboard focus too.
interface Row {
  date: string | null;
  label: string;
  sourceSlug: string;
  counts: (number | null)[];
  counts_display: (string | null)[];
  runtime: number | null;
  resource: string | null;
  release_version: string | null;
}
interface ToolReference {
  tool: string;
  value: number | null;
  display: string | null;
  date: string | null;
  sourceSlug: string | null;
}
interface Props {
  rows: Row[];
  toolReferences: ToolReference[];
}
const { rows, toolReferences } = Astro.props;

const references = toolReferences.filter((ref): ref is ToolReference & { value: number; display: string } => ref.value !== null);

const delta = (value: number, reference: number) => {
  const pct = ((value - reference) / reference) * 100;
  const rounded = Math.round(pct * 10) / 10;
  return rounded > 0 ? `+${rounded}%` : `${rounded}%`;
};
---

<div class="bench-version-cards">
  {rows.map((row) => {
    const value = row.counts[0];
    return (
      <a href={`/benchmarks/${row.sourceSlug}/`} class="bench-version-card">
        <span class="bench-version-card-label">{row.release_version ?? row.date ?? "Undated"}</span>
        <span class="bench-version-card-value">
          {row.counts_display[0] ?? "—"}
          <span class="bench-version-card-unit">precursor IDs</span>
        </span>
        {value !== null && references.length > 0 && (
          <span class="bench-version-card-compare">
            {references.map((ref, i) => (
              <>
                {i > 0 && " · "}
                <span class={`bench-version-card-tool bench-version-card-tool-${ref.tool.toLowerCase().replace(/[^a-z]/g, "")}`}>
                  {ref.tool} {ref.display} ({delta(value, ref.value)})
                </span>
              </>
            ))}
          </span>
        )}
      </a>
    );
  })}
</div>
