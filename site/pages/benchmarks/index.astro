---
// benchmarks/index.md를 옮긴 것. No-JS 데이터셋 토글은 라디오+라벨로 그대로 둔다.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ledgers from "../../data/benchmark_ledger.json";
import catalog from "../../data/benchmark_catalog.json";
import ComparisonWidget from "../../components/benchmark/ComparisonWidget.astro";
import VersionHistoryWidget from "../../components/benchmark/VersionHistoryWidget.astro";
import pxd055927 from "../../data/pxd055927/comparison.json";
import type { BenchmarkSummary } from "../../lib/benchmarkSummary";

const description =
  "SynapSpec benchmark history across LFQBench datasets and the PXD055927 reference comparison";

const [oe480, astral] = ledgers;
const pxd055927Name = "PXD055927 / semi-specific";
if (pxd055927.tools.slice(1).some((tool) => !tool.software_version?.trim())) {
  throw new Error("PXD055927 external references require their reported software versions");
}
const pxd055927Summary: BenchmarkSummary = {
  runCount: 3,
  showCompleteness: false,
  tools: pxd055927.tools.map((tool, index) => ({
    id: ["synapspec", "diann", "spectronaut"][index],
    label: `${tool.tool} (${index === 0 ? pxd055927.synapspec_version : tool.software_version})`,
    precursors: tool.precursor_count,
    completePercent: null,
  })),
};
const pxd055927Runs = [
  {
    date: null,
    label: `SynapSpec ${pxd055927.synapspec_version}`,
    sourceSlug: pxd055927.dataset,
    counts: [pxd055927.tools[0].precursor_count],
    counts_display: [pxd055927.tools[0].precursor_count.toLocaleString("en-US")],
    runtime: null,
    resource: null,
    release_version: pxd055927.synapspec_version,
  },
  {
    date: "2026-09-09",
    label: "SynapSpec v0.12.1 run · PXD055927 semi-specific",
    sourceSlug: "pxd055927-v0.12.1",
    counts: [126841],
    counts_display: ["126,841"],
    runtime: null,
    resource: null,
    release_version: "v0.12.1",
  },
];
---

<BaseLayout title="Benchmarks" description={description} noindex>
  <div class="container">
    <div class="page-header">
      <h1>Benchmarks</h1>
    </div>

    <input type="radio" name="dataset" id="dataset-oe480" class="bench-ds-input" checked />
    <input type="radio" name="dataset" id="dataset-astral" class="bench-ds-input" />
    <input type="radio" name="dataset" id="dataset-pxd055927" class="bench-ds-input" />

    <div class="bench-ds-head">
      <div class="bench-toggle-group" role="group" aria-label="Dataset">
        <label for="dataset-oe480" class="bench-toggle-btn">{oe480.name}</label>
        <label for="dataset-astral" class="bench-toggle-btn">{astral.name}</label>
        <label for="dataset-pxd055927" class="bench-toggle-btn">{pxd055927Name}</label>
      </div>
      <a href="#run-history-oe480" class="bench-ds-panel-oe480 bench-link">Run history ({oe480.rows.length})</a>
      <a href="#run-history-astral" class="bench-ds-panel-astral bench-link">Run history ({astral.rows.length})</a>
      <a href="#run-history-pxd055927" class="bench-ds-panel-pxd055927 bench-link">Run history ({pxd055927Runs.length})</a>
    </div>

    {ledgers.map((ledger) => {
      const isAstral = ledger.id === astral.id;
      const panelClass = isAstral ? "bench-ds-panel-astral" : "bench-ds-panel-oe480";
      const anchor = isAstral ? "run-history-astral" : "run-history-oe480";
      const latestRun = ledger.rows[0];
      if (!latestRun) throw new Error("Benchmark summary requires a recorded run: " + ledger.id);
      const inputFiles = catalog.recorded_runs[latestRun.sourceSlug as keyof typeof catalog.recorded_runs].recorded_run.files.map((file) => file.name);
      return (
        <div class={`bench-ds-panel ${panelClass}`}>
          <section class="block" aria-label="Selected results">
            <div class="section-header">
              <h2>SynapSpec &middot; DIA-NN &middot; Spectronaut</h2>
            </div>
            <ComparisonWidget slug={ledger.id} runSlug={latestRun.sourceSlug} runVersion={latestRun.release_version} toolReferences={ledger.toolReferences} />
          </section>

          <section id={anchor} class="block">
            <div class="section-header bench-section-wide">
              <h2>Run history</h2>
              <span class="run-history-hint">Click a bar for details</span>
            </div>
            <VersionHistoryWidget rows={ledger.rows} toolReferences={ledger.toolReferences} />
          </section>

          <details class="bench-details bench-border-t bench-details-flat">
            <summary>Source</summary>
            <p class="bench-source-note">
              {isAstral
                ? <a href="https://proteobench.cubimed.rub.de/Quant_LFQ_DIA_ion_Astral" class="bench-link" target="_blank" rel="noopener">Source: ProteoBench ↗</a>
                : <a href="https://www.ebi.ac.uk/pride/archive/projects/PXD028735" class="bench-link" target="_blank" rel="noopener">Source: PXD028735 on PRIDE ↗</a>}
            </p>
            <ul class="bench-file-list">{inputFiles.map((file) => <li>{file}</li>)}</ul>
          </details>
        </div>
      );
    })}

    <div class="bench-ds-panel bench-ds-panel-pxd055927">
      <section class="block" aria-label="PXD055927 reference comparison">
        <div class="section-header">
          <h2>SynapSpec &middot; FragPipe + DIA-NN &middot; Spectronaut</h2>
        </div>
        <ComparisonWidget summary={pxd055927Summary} cvSlug={pxd055927.dataset} />
        <p class="bench-source-note">
          <a href="https://www.ebi.ac.uk/pride/archive/projects/PXD055927" class="bench-link" target="_blank" rel="noopener">Source: PXD055927 on PRIDE ↗</a>
        </p>
        <p class="bench-axis-note bench-axis-note-left">Identification totals cover all doses. Completeness and peptide CV use the selected dose’s three replicates; external completeness is unavailable.</p>
      </section>
      <section id="run-history-pxd055927" class="block">
        <div class="section-header bench-section-wide">
          <h2>Run history</h2>
          <span class="run-history-hint">Click a bar for details</span>
        </div>
        <VersionHistoryWidget rows={pxd055927Runs} toolReferences={[]} />
      </section>
    </div>
  </div>
</BaseLayout>
