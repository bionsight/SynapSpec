---
// benchmarks/index.md를 옮긴 것. No-JS 데이터셋 토글은 라디오+라벨로 그대로 둔다.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ledgers from "../../data/benchmark_ledger.json";
import ComparisonWidget from "../../components/benchmark/ComparisonWidget.astro";

const description =
  "SynapSpec benchmark history on the LFQBench standard dataset — three-tool comparisons on fixed inputs, and every recorded run over time";

const [oe480, astral] = ledgers;
---

<BaseLayout title="Benchmarks" description={description} noindex>
  <div class="container">
    <div class="page-header">
      <h1>Benchmarks</h1>
    </div>

    <input type="radio" name="dataset" id="dataset-oe480" class="bench-ds-input" checked />
    <input type="radio" name="dataset" id="dataset-astral" class="bench-ds-input" />

    <div class="bench-ds-head">
      <div class="bench-toggle-group" role="group" aria-label="Dataset">
        <label for="dataset-oe480" class="bench-toggle-btn">{oe480.name}</label>
        <label for="dataset-astral" class="bench-toggle-btn">{astral.name}</label>
      </div>
      <a href="#run-history-oe480" class="bench-ds-panel-oe480 bench-link">Run history ({oe480.rows.length})</a>
      <a href="#run-history-astral" class="bench-ds-panel-astral bench-link">Run history ({astral.rows.length})</a>
    </div>

    {ledgers.map((ledger) => {
      const isAstral = ledger.id === astral.id;
      const panelClass = isAstral ? "bench-ds-panel-astral" : "bench-ds-panel-oe480";
      const anchor = isAstral ? "run-history-astral" : "run-history-oe480";
      return (
        <div class={`bench-ds-panel ${panelClass}`}>
          <section class="block" aria-label="Selected results">
            <div class="section-header">
              <h2>SynapSpec &middot; DIA-NN &middot; Spectronaut</h2>
            </div>
            <p class="bench-axis-note" style="text-align: left;"><a href={`/benchmarks/${ledger.id}/`} class="bench-link">Run details &amp; source</a></p>
            <ComparisonWidget slug={ledger.id} />
          </section>

          <section id={anchor} class="block">
            <div class="section-header bench-section-wide">
              <h2>Run history</h2>
            </div>
            <p class="bench-axis-note" style="text-align: left;">
              Reference (single run, not repeated over time):{" "}
              {ledger.toolReferences.map((ref, i) => (
                <>
                  {i > 0 && " · "}
                  {ref.display ? (
                    <>{ref.tool}{" "}<a href={`/benchmarks/${ref.sourceSlug}/`} class="bench-link">{ref.display}</a> ({ref.date})</>
                  ) : (
                    <>{ref.tool} &mdash; no run recorded</>
                  )}
                </>
              ))}
            </p>
            <div class="bench-table-wrap" style="max-width: 100%;">
              <table class="bench-table">
                <caption>Precursor IDs by tool &middot; &ldquo;&mdash;&rdquo; means not linked, not zero.</caption>
                <thead>
                  <tr><th>Run / date</th><th>Release version</th><th class="num">SynapSpec</th><th class="num">DIA-NN</th><th class="num">Spectronaut</th><th class="num">SynapSpec time</th><th>Resource</th></tr>
                </thead>
                <tbody>
                  {ledger.rows.map((row) => (
                    <tr>
                      <th scope="row">
                        <a href={`/benchmarks/${row.sourceSlug}/`}>{row.date ?? "Undated comparison"}</a>
                      </th>
                      <td>{row.release_version ?? "—"}</td>
                      {row.counts_display.map((value) => <td class="num">{value ?? "—"}</td>)}
                      <td class="num">{row.runtime ? `${Math.round(row.runtime * 100) / 100} h` : "—"}</td>
                      <td>{row.resource ?? "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <details class="bench-details bench-border-t" style="border-top: 1px solid var(--bench-border, #e2e2e2); border-radius: 0; padding-top: 1.25rem;">
            <summary>Fixed input-file list</summary>
            <ul class="bench-file-list">{ledger.files.map((file) => <li>{file}</li>)}</ul>
          </details>
        </div>
      );
    })}
  </div>
</BaseLayout>
